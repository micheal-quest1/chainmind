# ---- Google AI Studio (Gemini) -------------------------------------------
# Get one at https://aistudio.google.com/apikey
# Without this the system still runs end to end on deterministic fallbacks.
GEMINI_API_KEY=

# ---- Google Maps Platform -------------------------------------------------
# Needs these APIs enabled on the project:
#   Routes API, Geocoding API, (optional) Address Validation API, Maps Static API
GOOGLE_MAPS_API_KEY=

# ---- Storage --------------------------------------------------------------
# Container default is /data/chainmind.db; locally ./data/chainmind.db is fine.
CHAINMIND_DB=./data/chainmind.db

# ---- Model tiers (optional overrides) -------------------------------------
# Leave unset: the app probes at boot and pins each tier to a model that is
# verified working for your key.
# MODEL_TRIAGE=gemini-3.5-flash-lite
# MODEL_PLANNER=gemini-3.6-flash
# MODEL_REPAIR=gemini-3.7-flash
# MODEL_VISION=gemini-3.5-flash
# MODEL_CHAT=gemini-3.5-flash

# ---- Reliability tuning (optional) ----------------------------------------
# TOOL_MAX_ATTEMPTS=3
# BREAKER_THRESHOLD=4
# BREAKER_COOLDOWN_S=15
# LLM_TIMEOUT_S=25
# CHAINMIND_MOCK=false       # force deterministic mode, no API calls at all

# ---- MCP transport security (optional) ------------------------------------
# Unset: DNS-rebinding protection is OFF, so the public deployment accepts any
# Host. Set a comma-separated host list to turn protection ON and allow only
# those hosts (plus localhost). Required for any non-public deployment.
# MCP_ALLOWED_HOSTS=chainmind.example.com
